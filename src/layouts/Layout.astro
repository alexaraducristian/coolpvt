---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description = 'CoolPVT — Simulator profesional de dimensionare sisteme fotovoltaice termice. Dezvoltat la Universitatea Tehnică Gheorghe Asachi Iași.', activeNav = '' } = Astro.props;
const base = '/coolpvt';
const siteBase = '';
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AlexaVolt" />
    <meta property="og:locale" content="ro_RO" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans">
    
    <!-- Header matching main site style -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 md:px-6 flex items-center justify-between py-4">
        <a href={`${base}/`} class="flex items-center gap-2 font-black text-xl text-slate-900">
          <span class="text-2xl">⚡</span>
          <span>Cool<span class="text-orange-500">PVT</span></span>
        </a>

        <nav class="hidden md:flex items-center gap-2">
          <a href={`${base}/`} class:list={["px-3 py-2 rounded-xl text-sm font-bold transition-all", activeNav === 'home' ? "bg-blue-600 text-white shadow-lg" : "text-slate-700 hover:bg-slate-100 hover:text-blue-600"]}>
            Acasă
          </a>
          <a href={`${base}/simulator/`} class:list={["px-3 py-2 rounded-xl text-sm font-bold transition-all", activeNav === 'simulator' ? "bg-blue-600 text-white shadow-lg" : "text-slate-700 hover:bg-slate-100 hover:text-blue-600"]}>
            Simulator
          </a>
          <a href={`${base}/despre/`} class:list={["px-3 py-2 rounded-xl text-sm font-bold transition-all", activeNav === 'despre' ? "bg-blue-600 text-white shadow-lg" : "text-slate-700 hover:bg-slate-100 hover:text-blue-600"]}>
            Despre
          </a>
          <span class="w-px h-6 bg-slate-200 mx-2"></span>
          <a href={`${siteBase}/`} class="px-3 py-2 rounded-xl text-sm font-bold text-emerald-700 hover:bg-emerald-50 transition-all">
            ← AlexaVolt.ro
          </a>
        </nav>

        <!-- Mobile nav -->
        <div class="md:hidden flex items-center gap-2">
          <a href={`${base}/simulator/`} class="px-3 py-2 rounded-xl text-sm font-bold bg-blue-600 text-white">
            Simulator
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-6xl mx-auto w-full px-4 md:px-6 py-8">
      <slot />
    </main>

    <!-- Footer matching main site -->
    <footer class="bg-slate-900 text-slate-400 mt-12">
      <div class="max-w-6xl mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <p class="text-white font-bold text-lg">⚡ CoolPVT <span class="text-sm font-normal text-slate-500">v6.0</span></p>
            <p class="text-sm mt-1">Simulator dimensionare sisteme fotovoltaice termice</p>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-sm">
            <a href={`${siteBase}/`} class="text-blue-400 hover:text-white transition-colors">AlexaVolt.ro</a>
            <a href={`${siteBase}/servicii/panouri-fotovoltaice/`} class="hover:text-white transition-colors">Montaj Fotovoltaice</a>
            <a href={`${siteBase}/contact/`} class="hover:text-white transition-colors">Contact</a>
          </div>
        </div>
        <div class="border-t border-slate-800 mt-6 pt-6 text-xs text-center">
          <p>© {new Date().getFullYear()} CoolPVT — Dezvoltat de Marius Alexa & Valeriu-Sebastian Hudișteanu</p>
          <p class="mt-1 text-slate-600">Universitatea Tehnică „Gheorghe Asachi" din Iași</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  :root {
    --color-primary: #0f4c81;
    --color-primary-light: #1a6bb5;
    --color-primary-dark: #0a2f4e;
    --color-accent: #e88c30;
    --color-accent-light: #f5a623;
    --color-bg: #f4f6f9;
    --color-surface: #ffffff;
    --color-surface-alt: #f8fafb;
    --color-text: #1a2332;
    --color-text-muted: #5a6b7b;
    --color-border: #dce3eb;
    --color-success: #0d7a3e;
    --color-success-bg: #e8f5ee;
    --color-danger: #c62828;
    --color-info: #1565c0;
    --shadow-sm: 0 1px 2px rgba(10,47,78,0.05);
    --shadow-md: 0 4px 12px rgba(10,47,78,0.08);
    --shadow-lg: 0 8px 30px rgba(10,47,78,0.12);
    --radius: 8px;
    --radius-lg: 12px;
    --max-width: 1240px;
    --font: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
