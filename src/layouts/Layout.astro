---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description = 'CoolPVT — Simulator profesional de dimensionare sisteme fotovoltaice termice. Dezvoltat la Universitatea Tehnică Gheorghe Asachi Iași.', activeNav = '' } = Astro.props;
const base = '';
const siteBase = 'https://www.alexavolt.ro';
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="AlexaVolt" />
    <meta property="og:locale" content="ro_RO" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans">
    
    <!-- Header matching main site style -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 md:px-6 flex items-center justify-between py-4 md:py-6">
        <a href={`${base}/`} class="flex-shrink-0 transition-transform active:scale-95">
          <img src={`${base}/logo-coolpvt-v2.svg`} alt="CoolPVT Logo" class="h-12 md:h-16 w-auto" />
        </a>

        <nav class="hidden md:block">
          <ul class="flex items-center gap-2 lg:gap-3">
            <li class="whitespace-nowrap">
              <a href={`${base}/`} class:list={["transition-all duration-300 px-3 py-2 lg:px-4 lg:py-2.5 rounded-xl text-sm lg:text-base font-black uppercase tracking-tight", activeNav === 'home' ? "bg-blue-600 text-white shadow-lg shadow-blue-100 scale-105" : "text-slate-700 hover:bg-slate-100 hover:text-blue-600"]}>
                🏠 Acasă
              </a>
            </li>
            <li class="whitespace-nowrap">
              <a href={`${base}/simulator/`} class:list={["transition-all duration-300 px-3 py-2 lg:px-4 lg:py-2.5 rounded-xl text-sm lg:text-base font-black uppercase tracking-tight", activeNav === 'simulator' ? "bg-blue-600 text-white shadow-lg shadow-blue-100 scale-105" : "text-slate-700 hover:bg-slate-100 hover:text-blue-600"]}>
                ☀️ Simulator
              </a>
            </li>
            <li class="whitespace-nowrap">
              <a href={`${base}/despre/`} class:list={["transition-all duration-300 px-3 py-2 lg:px-4 lg:py-2.5 rounded-xl text-sm lg:text-base font-black uppercase tracking-tight", activeNav === 'despre' ? "bg-blue-600 text-white shadow-lg shadow-blue-100 scale-105" : "text-slate-700 hover:bg-slate-100 hover:text-blue-600"]}>
                📖 Despre
              </a>
            </li>
            <li class="whitespace-nowrap">
              <a href={`${siteBase}/`} class="transition-all duration-300 px-3 py-2 lg:px-4 lg:py-2.5 rounded-xl text-sm lg:text-base font-black uppercase tracking-tight text-emerald-700 hover:bg-emerald-50 hover:text-emerald-800">
                ← AlexaVolt.ro
              </a>
            </li>
          </ul>
        </nav>

        <!-- Mobile nav -->
        <div class="md:hidden flex items-center gap-2">
          <a href={`${base}/simulator/`} class="px-3 py-2 rounded-xl text-sm font-black uppercase tracking-tight bg-blue-600 text-white shadow-lg">
            ☀️ Simulator
          </a>
          <button id="cpvt-menu-btn" class="w-9 h-9 flex flex-col items-center justify-center rounded-lg bg-slate-100 hover:bg-slate-200" aria-label="Meniu">
            <span class="block w-5 h-0.5 bg-slate-700"></span>
            <span class="block w-5 h-0.5 bg-slate-700 mt-1.5"></span>
            <span class="block w-5 h-0.5 bg-slate-700 mt-1.5"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile menu overlay -->
    <div id="cpvt-overlay" class="fixed inset-0 bg-black/50 z-[60] hidden md:hidden"></div>
    <nav id="cpvt-drawer" class="fixed top-0 right-0 h-full w-64 bg-white z-[70] shadow-2xl transform translate-x-full transition-transform duration-300 md:hidden">
      <div class="p-4 border-b border-slate-100 flex justify-between items-center">
        <span class="font-black text-lg"><span class="text-orange-600">Cool</span>PVT</span>
        <button id="cpvt-menu-close" class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-100" aria-label="Închide">✕</button>
      </div>
      <ul class="p-4 space-y-2">
        <li><a href={`${base}/`} class="block px-4 py-3 rounded-xl font-bold hover:bg-slate-50">🏠 Acasă</a></li>
        <li><a href={`${base}/simulator/`} class="block px-4 py-3 rounded-xl font-bold hover:bg-slate-50">☀️ Simulator</a></li>
        <li><a href={`${base}/despre/`} class="block px-4 py-3 rounded-xl font-bold hover:bg-slate-50">📖 Despre</a></li>
        <li class="border-t border-slate-100 pt-2 mt-2"><a href={`${siteBase}/`} class="block px-4 py-3 rounded-xl font-bold text-emerald-700 hover:bg-emerald-50">← AlexaVolt.ro</a></li>
      </ul>
    </nav>
    <script>
      const menuBtn = document.getElementById('cpvt-menu-btn');
      const menuClose = document.getElementById('cpvt-menu-close');
      const overlay = document.getElementById('cpvt-overlay');
      const drawer = document.getElementById('cpvt-drawer');
      function openDrawer() { drawer?.classList.remove('translate-x-full'); overlay?.classList.remove('hidden'); }
      function closeDrawer() { drawer?.classList.add('translate-x-full'); overlay?.classList.add('hidden'); }
      menuBtn?.addEventListener('click', openDrawer);
      menuClose?.addEventListener('click', closeDrawer);
      overlay?.addEventListener('click', closeDrawer);
    </script>

    <main class="flex-1 max-w-6xl mx-auto w-full px-4 md:px-6 py-8">
      <slot />
    </main>

    <!-- Footer matching main site -->
    <footer class="bg-slate-900 text-slate-400 mt-12">
      <div class="max-w-6xl mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <p class="text-white font-bold text-lg">⚡ <span class="text-orange-400">Cool</span><span class="text-white">PVT</span> <span class="text-sm font-normal text-slate-500">v6.0</span></p>
            <p class="text-sm mt-1">Simulator dimensionare sisteme fotovoltaice termice</p>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-sm">
            <a href={`${siteBase}/`} class="text-blue-400 hover:text-white transition-colors">AlexaVolt.ro</a>
            <a href={`${siteBase}/servicii/panouri-fotovoltaice/`} class="hover:text-white transition-colors">Montaj Fotovoltaice</a>
            <a href={`${siteBase}/contact/`} class="hover:text-white transition-colors">Contact</a>
          </div>
        </div>
        <div class="border-t border-slate-800 mt-6 pt-6 text-xs text-center">
          <p>© {new Date().getFullYear()} CoolPVT — Dezvoltat de Marius Alexa & Valeriu-Sebastian Hudișteanu</p>
          <p class="mt-1 text-slate-600">Universitatea Tehnică „Gheorghe Asachi" din Iași</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  :root {
    --color-primary: #0f4c81;
    --color-primary-light: #1a6bb5;
    --color-primary-dark: #0a2f4e;
    --color-accent: #e88c30;
    --color-accent-light: #f5a623;
    --color-bg: #f4f6f9;
    --color-surface: #ffffff;
    --color-surface-alt: #f8fafb;
    --color-text: #1a2332;
    --color-text-muted: #5a6b7b;
    --color-border: #dce3eb;
    --color-success: #0d7a3e;
    --color-success-bg: #e8f5ee;
    --color-danger: #c62828;
    --color-info: #1565c0;
    --shadow-sm: 0 1px 2px rgba(10,47,78,0.05);
    --shadow-md: 0 4px 12px rgba(10,47,78,0.08);
    --shadow-lg: 0 8px 30px rgba(10,47,78,0.12);
    --radius: 8px;
    --radius-lg: 12px;
    --max-width: 1240px;
    --font: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
