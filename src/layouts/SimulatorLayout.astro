---
import Layout from './Layout.astro';

interface Props {
  title: string;
  activeStep: string;
}

const { title, activeStep } = Astro.props;
const base = '/simulator';

const steps = [
  { id: 'dimensionare', label: 'Dimensionare PV', icon: '☀️', href: `${base}/` },
  { id: 'consumatori', label: 'Consumatori', icon: '🔌', href: `${base}/consumatori/` },
  { id: 'calcul-electric', label: 'Calcul Electric', icon: '⚡', href: `${base}/calcul-electric/` },
  { id: 'racire-pv', label: 'Răcire PV', icon: '💨', href: `${base}/racire-pv/` },
  { id: 'racire-pvt', label: 'Răcire PVT', icon: '💧', href: `${base}/racire-pvt/` },
  { id: 'economic', label: 'Analiză Economică', icon: '💰', href: `${base}/economic/` },
  { id: 'grafic', label: 'Grafic Amortizare', icon: '📊', href: `${base}/grafic/` },
];

// Arrows between steps showing data flow direction
// 'down' = normal forward flow, 'up' = data flows back, 'both' = bidirectional
const arrows = [
  { type: 'down', label: 'consum' },       // consumatori → dimensionare... wait
  { type: 'down', label: 'panouri, kWp' }, // dimensionare → calcul-electric
  { type: 'down' },                         // calcul-electric → racire-pv
  { type: 'up', label: 'coef. răcire' },   // racire-pv → (back to dimensionare)
  { type: 'down', label: 'nr. panouri' },  // racire-pvt → economic
  { type: 'down', label: 'investiție' },   // economic → grafic
];
---

<Layout title={title} activeNav="simulator">
  <div class="simulator-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h3>Etape Simulator</h3>
        <span class="sidebar-badge">{steps.findIndex(s => s.id === activeStep) + 1}/{steps.length}</span>
      </div>
      <nav class="step-nav">
        {steps.map((step, i) => (
          <>
            <a href={step.href} class={`step-link ${activeStep === step.id ? 'active' : ''}`}>
              <span class="step-icon">{step.icon}</span>
              <span class="step-label">{step.label}</span>
            </a>
            {i < steps.length - 1 && (
              <div class={`flow-arrow ${arrows[i]?.type === 'up' ? 'arrow-up' : 'arrow-down'}`}>
                <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true">
                  {arrows[i]?.type === 'up' ? (
                    <path d="M6 14 L6 3 M2 7 L6 1 L10 7" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  ) : (
                    <path d="M6 0 L6 11 M2 7 L6 13 L10 7" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  )}
                </svg>
                {arrows[i]?.label && <span class="flow-label">{arrows[i].label}</span>}
              </div>
            )}
          </>
        ))}
      </nav>
    </aside>
    <section class="content">
      <slot />
    </section>
  </div>
</Layout>

<style>
  .simulator-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.5rem;
    min-height: 70vh;
  }

  .sidebar {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    height: fit-content;
    position: sticky;
    top: 5rem;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-header h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .sidebar-badge {
    font-size: 0.7rem;
    background: var(--color-primary);
    color: white;
    padding: 0.2rem 0.5rem;
    border-radius: 10px;
    font-weight: 600;
  }

  .step-nav { display: flex; flex-direction: column; gap: 0.2rem; }

  .step-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    transition: all 0.15s;
    position: relative;
  }

  .step-link:hover { background: var(--color-surface-alt); color: var(--color-primary); }

  .step-link.active {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(15,76,129,0.3);
  }

  .step-icon { font-size: 0.9rem; flex-shrink: 0; }
  .step-label { flex: 1; }

  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.15rem 0;
    margin-left: 0.65rem;
  }

  .flow-arrow.arrow-down { color: var(--color-primary-light); }
  .flow-arrow.arrow-up { color: var(--color-accent); }

  .flow-label {
    font-size: 0.6rem;
    color: var(--color-text-muted);
    font-weight: 500;
    opacity: 0.8;
    white-space: nowrap;
  }

  .content { min-width: 0; }

  @media (max-width: 768px) {
    .simulator-layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
    .step-nav { flex-direction: row; flex-wrap: wrap; gap: 0.3rem; align-items: center; }
    .step-link { font-size: 0.75rem; padding: 0.4rem 0.5rem; }
    .step-icon { display: none; }
    .flow-arrow { margin-left: 0; padding: 0 0.1rem; }
    .flow-arrow svg { width: 10px; height: 10px; transform: rotate(-90deg); }
    .flow-label { display: none; }
  }
</style>
