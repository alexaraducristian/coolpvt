---
import Layout from './Layout.astro';

interface Props {
  title: string;
  activeStep: string;
}

const { title, activeStep } = Astro.props;
const base = '/coolpvt/simulator';

const steps = [
  { id: 'dimensionare', label: 'Dimensionare PV', icon: '☀️', href: `${base}/` },
  { id: 'consumatori', label: 'Consumatori', icon: '🔌', href: `${base}/consumatori/` },
  { id: 'calcul-electric', label: 'Calcul Electric', icon: '⚡', href: `${base}/calcul-electric/` },
  { id: 'racire-pv', label: 'Răcire PV', icon: '💨', href: `${base}/racire-pv/` },
  { id: 'racire-pvt', label: 'Răcire PVT', icon: '💧', href: `${base}/racire-pvt/` },
  { id: 'economic', label: 'Analiză Economică', icon: '💰', href: `${base}/economic/` },
  { id: 'grafic', label: 'Grafic Amortizare', icon: '📊', href: `${base}/grafic/` },
];
---

<Layout title={title} activeNav="simulator">
  <div class="simulator-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h3>Etape Simulator</h3>
        <span class="sidebar-badge">{steps.findIndex(s => s.id === activeStep) + 1}/{steps.length}</span>
      </div>
      <nav class="step-nav">
        {steps.map((step, i) => (
          <a href={step.href} class={`step-link ${activeStep === step.id ? 'active' : ''}`}>
            <span class="step-icon">{step.icon}</span>
            <span class="step-label">{step.label}</span>
            {activeStep === step.id && <span class="step-indicator" />}
          </a>
        ))}
      </nav>
    </aside>
    <section class="content">
      <slot />
    </section>
  </div>
</Layout>

<style>
  .simulator-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.5rem;
    min-height: 70vh;
  }

  .sidebar {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    height: fit-content;
    position: sticky;
    top: 5rem;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-header h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .sidebar-badge {
    font-size: 0.7rem;
    background: var(--color-primary);
    color: white;
    padding: 0.2rem 0.5rem;
    border-radius: 10px;
    font-weight: 600;
  }

  .step-nav { display: flex; flex-direction: column; gap: 0.2rem; }

  .step-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    transition: all 0.15s;
    position: relative;
  }

  .step-link:hover { background: var(--color-surface-alt); color: var(--color-primary); }

  .step-link.active {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(15,76,129,0.3);
  }

  .step-icon { font-size: 0.9rem; flex-shrink: 0; }
  .step-label { flex: 1; }
  .step-indicator { display: none; }

  .content { min-width: 0; }

  @media (max-width: 768px) {
    .simulator-layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
    .step-nav { flex-direction: row; flex-wrap: wrap; gap: 0.3rem; }
    .step-link { font-size: 0.75rem; padding: 0.4rem 0.5rem; }
    .step-icon { display: none; }
  }
</style>
