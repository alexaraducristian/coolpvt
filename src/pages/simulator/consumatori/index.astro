---
import SimulatorLayout from '../../../layouts/SimulatorLayout.astro';

const consumatori = [
  { id: 'incandescent', name: 'Iluminat incandescent', putere: 60, ore: 6, buc: 1 },
  { id: 'fluorescent', name: 'Iluminat fluorescent', putere: 13, ore: 6, buc: 1 },
  { id: 'led', name: 'Iluminat LED', putere: 10, ore: 6, buc: 5 },
  { id: 'centrala', name: 'Centrală termică', putere: 150, ore: 10, buc: 1 },
  { id: 'boiler', name: 'Boiler electric', putere: 1500, ore: 2, buc: 1 },
  { id: 'cuptor', name: 'Cuptor electric', putere: 1500, ore: 1, buc: 1 },
  { id: 'plita', name: 'Plită electrică', putere: 1800, ore: 2, buc: 1 },
  { id: 'frigider', name: 'Frigider', putere: 353, ore: 4, buc: 1 },
  { id: 'microunde', name: 'Cuptor microunde', putere: 1500, ore: 1, buc: 1 },
  { id: 'masina-spalat', name: 'Mașină de spălat', putere: 250, ore: 1, buc: 1 },
  { id: 'masina-vase', name: 'Mașină spălat vase', putere: 700, ore: 1, buc: 1 },
  { id: 'televizor', name: 'Televizor', putere: 150, ore: 4, buc: 1 },
  { id: 'mixer', name: 'Mixer / Robot bucătărie', putere: 400, ore: 1, buc: 1 },
  { id: 'uscator', name: 'Uscător rufe', putere: 1000, ore: 1, buc: 1 },
  { id: 'cafea', name: 'Filtru cafea / Espressor', putere: 1000, ore: 1, buc: 1 },
];
const defaultChecked = ['led', 'centrala', 'boiler', 'frigider', 'masina-spalat', 'televizor', 'cafea'];
---

<SimulatorLayout title="Consumatori — CoolPVT" activeStep="consumatori">
  <h1>Calculator Consumatori Electrici</h1>
  <p class="intro">Bifați receptoarele electrice din locuință și ajustați valorile. Se calculează automat consumul zilnic și lunar.</p>

  <div class="table-container">
    <table id="tbl-consumatori">
      <thead>
        <tr>
          <th>Activ</th>
          <th>Receptor electric</th>
          <th>Nr. buc</th>
          <th>Putere [W]</th>
          <th>Ore/zi</th>
          <th>E zilnic [kWh]</th>
          <th>E lunar [kWh]</th>
        </tr>
      </thead>
      <tbody>
        {consumatori.map(c => (
          <tr data-id={c.id}>
            <td><input type="checkbox" class="chk-activ" checked={defaultChecked.includes(c.id)} /></td>
            <td>{c.name}</td>
            <td><input type="number" class="inp-buc" value={c.buc} min="0" max="50" /></td>
            <td><input type="number" class="inp-putere" value={c.putere} min="0" step="10" /></td>
            <td><input type="number" class="inp-ore" value={c.ore} min="0" max="24" /></td>
            <td class="val-zilnic">—</td>
            <td class="val-lunar">—</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr class="total-row">
          <td colspan="5"><strong>TOTAL</strong></td>
          <td><strong id="total-zilnic">0</strong></td>
          <td><strong id="total-lunar">0</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="extra-receptoare">
    <h3>Receptoare suplimentare (personalizate)</h3>
    <p class="extra-hint">Adaugă aparate care nu sunt în lista de mai sus.</p>
    <table id="tbl-extra" class="tbl-extra">
      <thead>
        <tr>
          <th>Nume receptor</th>
          <th>Putere [W]</th>
          <th>Ore/zi</th>
          <th>Nr. buc</th>
          <th>E lunar [kWh]</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="extra-body"></tbody>
      <tfoot>
        <tr class="total-row">
          <td colspan="4"><strong>TOTAL suplimentar</strong></td>
          <td><strong id="extra-total-lunar">0 kWh</strong></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
    <button type="button" id="btn-add-receptor" class="btn-secondary">+ Adaugă receptor</button>
  </div>

  <div class="actions">
    <button type="button" id="btn-confirma" class="btn-primary">Confirmă și revino la Dimensionare</button>
  </div>
</SimulatorLayout>

<script>
  // Calcul total receptoare principale
  function recalculateMain(): number {
    let totalZ = 0, totalL = 0;
    document.querySelectorAll('#tbl-consumatori tbody tr').forEach(row => {
      const chk = row.querySelector('.chk-activ') as HTMLInputElement;
      const buc = parseFloat((row.querySelector('.inp-buc') as HTMLInputElement).value) || 0;
      const putere = parseFloat((row.querySelector('.inp-putere') as HTMLInputElement).value) || 0;
      const ore = parseFloat((row.querySelector('.inp-ore') as HTMLInputElement).value) || 0;
      if (chk.checked) {
        const ez = (buc * putere * ore) / 1000;
        const el = ez * 30;
        row.querySelector('.val-zilnic')!.textContent = ez.toFixed(2);
        row.querySelector('.val-lunar')!.textContent = el.toFixed(1);
        totalZ += ez; totalL += el;
      } else {
        row.querySelector('.val-zilnic')!.textContent = '—';
        row.querySelector('.val-lunar')!.textContent = '—';
      }
    });
    document.getElementById('total-zilnic')!.textContent = totalZ.toFixed(2) + ' kWh';
    document.getElementById('total-lunar')!.textContent = totalL.toFixed(1) + ' kWh';
    return totalL;
  }

  // Calcul total receptoare suplimentare
  function recalculateExtra(): number {
    let totalL = 0;
    document.querySelectorAll('#extra-body tr').forEach(row => {
      const putere = parseFloat((row.querySelector('.ext-putere') as HTMLInputElement).value) || 0;
      const ore = parseFloat((row.querySelector('.ext-ore') as HTMLInputElement).value) || 0;
      const buc = parseFloat((row.querySelector('.ext-buc') as HTMLInputElement).value) || 0;
      const el = (buc * putere * ore / 1000) * 30;
      row.querySelector('.ext-lunar')!.textContent = el.toFixed(1);
      totalL += el;
    });
    document.getElementById('extra-total-lunar')!.textContent = totalL.toFixed(1) + ' kWh';
    return totalL;
  }

  function recalculateAll() {
    recalculateMain();
    recalculateExtra();
  }

  // Event listeners pe tabelul principal
  document.querySelectorAll('#tbl-consumatori input').forEach(inp => {
    inp.addEventListener('change', recalculateAll);
    inp.addEventListener('input', recalculateAll);
  });

  // Calcul initial
  recalculateAll();

  // Adaugă receptor suplimentar
  let extraCount = 0;
  document.getElementById('btn-add-receptor')!.addEventListener('click', () => {
    extraCount++;
    const tbody = document.getElementById('extra-body')!;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="text" class="ext-name" placeholder="Ex: Pompă recirculare" value="" /></td>
      <td><input type="number" class="ext-putere" value="100" min="0" step="10" /></td>
      <td><input type="number" class="ext-ore" value="2" min="0" max="24" step="0.5" /></td>
      <td><input type="number" class="ext-buc" value="1" min="1" max="50" /></td>
      <td class="ext-lunar">6.0</td>
      <td><button type="button" class="btn-remove" title="Șterge">✕</button></td>
    `;
    tbody.appendChild(tr);

    // Atașare event listeners pe noile inputuri
    tr.querySelectorAll('input[type="number"]').forEach(inp => {
      inp.addEventListener('change', recalculateAll);
      inp.addEventListener('input', recalculateAll);
    });

    // Buton ștergere
    tr.querySelector('.btn-remove')!.addEventListener('click', () => {
      tr.remove();
      recalculateAll();
    });

    recalculateAll();
  });

  // Confirmă și revino — include AMBELE totaluri
  document.getElementById('btn-confirma')!.addEventListener('click', () => {
    const totalMain = recalculateMain();
    const totalExtra = recalculateExtra();
    const totalValue = totalMain + totalExtra;

    if (confirm(`Consumul lunar total calculat: ${totalValue.toFixed(1)} kWh/lună\n(Principal: ${totalMain.toFixed(1)} kWh + Suplimentar: ${totalExtra.toFixed(1)} kWh)\n\nDoriți să folosiți această valoare pentru dimensionarea sistemului fotovoltaic?`)) {
      window.location.href = '/simulator/?consum=' + totalValue.toFixed(1);
    }
  });
</script>

<style>
  h1 { font-size: 1.8rem; color: var(--color-primary-dark); margin-bottom: 0.5rem; }
  .intro { color: var(--color-text-muted); margin-bottom: 1.5rem; }
  .table-container { overflow-x: auto; background: var(--color-surface); border-radius: 12px; border: 1px solid #e2e8f0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { background: var(--color-primary-dark); color: white; padding: 0.6rem 0.5rem; text-align: left; font-size: 0.8rem; }
  td { padding: 0.5rem; border-bottom: 1px solid #f1f5f9; }
  tbody tr:hover { background: #f8fafc; }
  .inp-buc, .inp-ore { width: 60px; }
  .inp-putere { width: 80px; }
  input[type="number"] { padding: 0.3rem 0.4rem; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.85rem; }
  .total-row td { background: #ecfdf5; border-top: 2px solid #6ee7b7; }
  .extra-receptoare { margin-top: 1.5rem; background: var(--color-surface); border-radius: 12px; padding: 1.5rem; border: 1px solid #e2e8f0; }
  .extra-receptoare h3 { font-size: 1rem; margin-bottom: 0.25rem; color: var(--color-primary-dark); }
  .extra-hint { font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .tbl-extra { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin-bottom: 1rem; }
  .tbl-extra th { background: #f8fafc; color: var(--color-text-muted); padding: 0.5rem; text-align: left; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; border-bottom: 1px solid #e2e8f0; }
  .tbl-extra td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
  .tbl-extra .total-row td { background: #ecfdf5; border-top: 2px solid #6ee7b7; }
  .tbl-extra input[type="text"] { width: 100%; min-width: 140px; }
  .tbl-extra input[type="number"] { width: 70px; }
  .btn-remove { background: none; border: none; color: #ef4444; cursor: pointer; font-size: 1rem; padding: 0.25rem 0.5rem; border-radius: 4px; }
  .btn-remove:hover { background: #fee2e2; }
  .actions { margin-top: 1.5rem; text-align: center; }
  .btn-primary { background: var(--color-primary); color: white; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; }
  .btn-primary:hover { background: var(--color-primary-dark); }
  .btn-secondary { background: #f1f5f9; color: var(--color-primary); border: 1px solid #cbd5e1; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 9999; backdrop-filter: blur(2px); }
  .modal-box { background: white; border-radius: 12px; padding: 2rem; max-width: 420px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); animation: modalIn 0.2s ease; }
  .modal-box h3 { font-size: 1.1rem; color: var(--color-primary-dark); margin-bottom: 0.75rem; }
  .modal-box p { color: var(--color-text); margin-bottom: 0.5rem; font-size: 0.95rem; }
  .modal-box strong { color: var(--color-primary); }
  .modal-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
  .modal-btn { padding: 0.6rem 1.25rem; border-radius: 6px; font-size: 0.95rem; font-weight: 600; cursor: pointer; border: none; }
  .modal-btn-yes { background: var(--color-primary); color: white; }
  .modal-btn-yes:hover { background: var(--color-primary-dark); }
  .modal-btn-no { background: #f1f5f9; color: var(--color-text); border: 1px solid #cbd5e1; }
  .modal-btn-no:hover { background: #e2e8f0; }
</style>
