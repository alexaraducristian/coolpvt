---
import SimulatorLayout from '../../layouts/SimulatorLayout.astro';
---

<SimulatorLayout title="Dimensionare PV — CoolPVT" activeStep="dimensionare">
  <h1>Dimensionare Sistem Fotovoltaic</h1>
  <p class="intro">Completați pașii de mai jos pentru dimensionarea sistemului PV.</p>

  <form id="form-dimensionare" class="form-grid">
    <!-- Pas 1: Modalitate dimensionare -->
    <div class="card">
      <h2><span class="step-num">1</span> Modalitate determinare consum</h2>
      <div class="field-group">
        <label><input type="radio" name="modalitate" value="consum" checked /> Consum lunar estimat (kWh)</label>
        <label><input type="radio" name="modalitate" value="putere" /> Putere instalată dorită (kWp)</label>
        <label><input type="radio" name="modalitate" value="receptoare" /> Receptoare electrice (detaliat)</label>
      </div>
      <div id="input-consum" class="sub-field">
        <label for="consum-lunar">Consum lunar [kWh/lună]:</label>
        <input type="number" id="consum-lunar" value="300" min="0" step="10" />
      </div>
      <div id="input-putere" class="sub-field" style="display:none;">
        <label for="putere-instalata">Putere instalată dorită [kWp]:</label>
        <input type="number" id="putere-instalata" value="5" min="0" step="0.5" />
      </div>
      <div id="input-receptoare" class="sub-field" style="display:none;">
        <p>Mergeți la pagina <a href="/coolpvt/simulator/consumatori/">Consumatori</a> pentru detaliere.</p>
      </div>
    </div>

    <!-- Pas 2: Perioada de dimensionare -->
    <div class="card">
      <h2><span class="step-num">2</span> Perioadă dimensionare</h2>
      <select id="perioada">
        <option value="VARA">VARA (producție maximă în Iunie)</option>
        <option value="IARNA">IARNA (producție în Decembrie)</option>
        <option value="ANUAL" selected>ANUAL (media anuală)</option>
      </select>
    </div>

    <!-- Pas 3: Orientare -->
    <div class="card">
      <h2><span class="step-num">3</span> Orientare panouri fotovoltaice</h2>
      <select id="orientare">
        <option value="SUD" selected>SUD</option>
        <option value="SUD-EST">SUD-EST</option>
        <option value="SUD-VEST">SUD-VEST</option>
        <option value="EST">EST</option>
        <option value="VEST">VEST</option>
      </select>
    </div>

    <!-- Pas 4: Unghi inclinare -->
    <div class="card">
      <h2><span class="step-num">4</span> Unghi de înclinare</h2>
      <select id="unghi">
        <option value="5">5°</option><option value="10">10°</option>
        <option value="15">15°</option><option value="20">20°</option>
        <option value="25">25°</option><option value="30">30°</option>
        <option value="35" selected>35°</option><option value="40">40°</option>
        <option value="45">45°</option><option value="50">50°</option>
        <option value="55">55°</option><option value="60">60°</option>
        <option value="65">65°</option><option value="70">70°</option>
        <option value="75">75°</option><option value="80">80°</option>
        <option value="85">85°</option><option value="90">90° (vertical)</option>
      </select>
      <p class="hint" id="sugestie-unghi">Înclinare optimă recomandată = 35°</p>
    </div>

    <!-- Pas 5: Selectare panou -->
    <div class="card">
      <h2><span class="step-num">5</span> Selectare panou fotovoltaic</h2>
      <select id="panou-pv">
        <option value="PV1" data-tip="Policristalin" data-putere="280" data-l="1.650" data-w="0.992" data-rand="17.11" data-deg="0.13">PV1 policristalin 280 Wp</option>
        <option value="PV2" data-tip="Monocristalin" data-putere="305" data-l="1.640" data-w="0.992" data-rand="18.75" data-deg="0.13">PV2 monocristalin 305 Wp</option>
        <option value="PV3" data-tip="Monocristalin" data-putere="395" data-l="1.684" data-w="1.000" data-rand="21.2" data-deg="0.13">PV3 monocristalin 395 Wp</option>
        <option value="PV5" data-tip="Monocristalin" data-putere="310" data-l="1.640" data-w="0.992" data-rand="19.05" data-deg="0.11">PV5 monocristalin 310 Wp</option>
        <option value="PV6" data-tip="Monocristalin" data-putere="380" data-l="1.769" data-w="1.052" data-rand="20.3" data-deg="0.13">PV6 monocristalin 380 Wp</option>
        <option value="PV7" data-tip="Hibrid" data-putere="420" data-l="1.800" data-w="1.150" data-rand="25.3" data-deg="0.20">PV7 hibrid 420 Wp</option>
        <option value="PV8" data-tip="Monocristalin" data-putere="425" data-l="2.100" data-w="1.040" data-rand="21.3" data-deg="0.13">PV8 monocristalin 425 Wp</option>
        <option value="PVC4" data-tip="Monocristalin" data-putere="450" data-l="2.120" data-w="1.052" data-rand="20.2" data-deg="0.13" selected>PV C4 monocristalin 450 Wp</option>
        <option value="PVC6" data-tip="Monocristalin" data-putere="460" data-l="2.120" data-w="1.052" data-rand="20.6" data-deg="0.13">PV C6 monocristalin 460 Wp</option>
        <option value="PVC14" data-tip="Monocristalin" data-putere="500" data-l="2.108" data-w="1.048" data-rand="21.2" data-deg="0.13">PV C14 monocristalin 500 Wp</option>
        <option value="PVC15" data-tip="Monocristalin" data-putere="545" data-l="2.108" data-w="1.048" data-rand="21.9" data-deg="0.13">PV C15 monocristalin 545 Wp</option>
        <option value="PVC7" data-tip="Monocristalin" data-putere="640" data-l="2.384" data-w="1.303" data-rand="20.6" data-deg="0.13">PV C7 monocristalin 640 Wp</option>
        <option value="PVC13" data-tip="Monocristalin" data-putere="670" data-l="2.384" data-w="1.303" data-rand="21.6" data-deg="0.13">PV C13 monocristalin 670 Wp</option>
      </select>
      <div class="panel-info" id="panel-info">
        <span>Tip: <strong id="info-tip">Monocristalin</strong></span>
        <span>Putere: <strong id="info-putere">450</strong> Wp</span>
        <span>Dimensiuni: <strong id="info-dim">2.120 × 1.052</strong> m</span>
        <span>Randament: <strong id="info-rand">20.2</strong>%</span>
        <span>Suprafață: <strong id="info-suprafata">2.23</strong> m²</span>
      </div>
    </div>

    <!-- Pas 6: Localitate -->
    <div class="card">
      <h2><span class="step-num">6</span> Localitate / Județ</h2>
      <select id="judet">
        <optgroup label="Regiunea NE">
          <option value="iasi" selected>Iași</option>
          <option value="iasi">Botoșani</option>
          <option value="iasi">Suceava</option>
          <option value="iasi">Neamț</option>
          <option value="iasi">Bacău</option>
          <option value="iasi">Vaslui</option>
        </optgroup>
        <optgroup label="Regiunea SE">
          <option value="galati">Galați</option>
          <option value="galati">Brăila</option>
          <option value="galati">Vrancea</option>
          <option value="galati">Buzău</option>
          <option value="constanta">Constanța</option>
          <option value="constanta">Tulcea</option>
        </optgroup>
        <optgroup label="Regiunea B-IF / SM">
          <option value="bucuresti">București</option>
          <option value="bucuresti">Ilfov</option>
          <option value="bucuresti">Prahova</option>
          <option value="bucuresti">Dâmbovița</option>
          <option value="bucuresti">Călărași</option>
          <option value="bucuresti">Teleorman</option>
          <option value="bucuresti">Argeș</option>
        </optgroup>
        <optgroup label="Regiunea SV">
          <option value="craiova">Dolj</option>
          <option value="craiova">Olt</option>
          <option value="craiova">Vâlcea</option>
          <option value="craiova">Gorj</option>
          <option value="craiova">Mehedinți</option>
        </optgroup>
        <optgroup label="Regiunea V">
          <option value="timisoara">Timiș</option>
          <option value="timisoara">Arad</option>
          <option value="timisoara">Hunedoara</option>
          <option value="timisoara">Caraș-Severin</option>
        </optgroup>
        <optgroup label="Regiunea NV / C">
          <option value="cluj">Cluj</option>
          <option value="cluj">Bihor</option>
          <option value="cluj">Satu Mare</option>
          <option value="cluj">Maramureș</option>
          <option value="cluj">Sălaj</option>
          <option value="cluj">Bistrița-Năsăud</option>
          <option value="cluj">Alba</option>
          <option value="cluj">Mureș</option>
          <option value="cluj">Harghita</option>
          <option value="cluj">Sibiu</option>
          <option value="cluj">Brașov</option>
        </optgroup>
      </select>
    </div>

    <!-- Pas 7: Opțiuni avansate -->
    <div class="card">
      <h2><span class="step-num">7</span> Opțiuni avansate</h2>
      <div class="field-group">
        <label><input type="checkbox" id="check-racire" /> Activare răcire PV</label>
        <label><input type="checkbox" id="check-racire-pvt" /> Activare răcire PVT (termică)</label>
        <label><input type="checkbox" id="check-dosar" /> Dosar prosumator</label>
        <label><input type="checkbox" id="check-priza" /> Priză de pământ existentă</label>
      </div>
      <div class="sub-field">
        <label for="randament-invertor">Randament invertor [0-1]:</label>
        <input type="number" id="randament-invertor" value="0.97" min="0.8" max="1" step="0.01" />
      </div>
    </div>

    <!-- Pas 8: Calculare -->
    <div class="card card-action">
      <h2><span class="step-num">8</span> Calculare</h2>
      <button type="button" id="btn-calculeaza" class="btn-primary">Calculează Dimensionare</button>
    </div>
  </form>

  <!-- Rezultate -->
  <div class="results-panel" id="results" style="display:none;">
    <h2>Rezultate Dimensionare</h2>
    <div class="results-grid">
      <div class="res-item"><span class="res-label">Nr. panouri fotovoltaice</span><span class="res-value" id="res-nr-panouri">—</span></div>
      <div class="res-item"><span class="res-label">Putere instalată</span><span class="res-value" id="res-putere">—</span></div>
      <div class="res-item"><span class="res-label">Suprafață totală panouri</span><span class="res-value" id="res-suprafata">—</span></div>
      <div class="res-item"><span class="res-label">Energie produsă/an (Anul 1)</span><span class="res-value" id="res-energie-an1">—</span></div>
      <div class="res-item"><span class="res-label">Energie produsă/an (Anul 20)</span><span class="res-value" id="res-energie-an20">—</span></div>
      <div class="res-item"><span class="res-label">Energie produsă/lună (medie)</span><span class="res-value" id="res-energie-luna">—</span></div>
    </div>
    <div class="next-steps">
      <p>Continuați cu:</p>
      <a href="/coolpvt/simulator/calcul-electric/" class="btn-secondary">Calcul Electric →</a>
      <a href="/coolpvt/simulator/economic/" class="btn-secondary">Analiză Economică →</a>
    </div>
  </div>
</SimulatorLayout>

<script>
  // Baza de date radiatie solara [kWh/mp/luna] per regiune, orientare SUD, unghi 35°
  // Extras din aplicatia originala (valori lunare ian-dec)
  // Format: { regiune: { orientare: { unghi: [ian, feb, ..., dec] } } }
  // Valori simplificate - medie pe mp la unghi 35° SUD
  const solarData: Record<string, Record<string, Record<number, number[]>>> = {
